#!/usr/bin/env bash

set -e

echo "🔍 Pre-deployment Checks"
echo "========================"
echo ""

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

ERRORS=0
WARNINGS=0

# Check if .env.kamal exists
echo -n "Checking .env.kamal... "
if [ -f .env.kamal ]; then
  echo -e "${GREEN}✓${NC}"
  source .env.kamal
else
  echo -e "${RED}✗${NC}"
  echo "  → Run: cp .env.kamal.example .env.kamal"
  ((ERRORS++))
fi

# Check required env vars
echo -n "Checking GHCR_TOKEN... "
if [ -n "$GHCR_TOKEN" ]; then
  echo -e "${GREEN}✓${NC}"
else
  echo -e "${RED}✗${NC}"
  echo "  → Set GHCR_TOKEN in .env.kamal"
  ((ERRORS++))
fi

echo -n "Checking SERVER_IP... "
if [ -n "$SERVER_IP" ]; then
  echo -e "${GREEN}✓${NC}"
else
  echo -e "${RED}✗${NC}"
  echo "  → Set SERVER_IP in .env.kamal"
  ((ERRORS++))
fi

echo -n "Checking SSH_USER... "
if [ -n "$SSH_USER" ]; then
  echo -e "${GREEN}✓${NC}"
else
  echo -e "${RED}✗${NC}"
  echo "  → Set SSH_USER in .env.kamal"
  ((ERRORS++))
fi

# Check config/master.key
echo -n "Checking config/master.key... "
if [ -f config/master.key ]; then
  echo -e "${GREEN}✓${NC}"
else
  echo -e "${RED}✗${NC}"
  echo "  → Rails master key is required"
  ((ERRORS++))
fi

# Check Dockerfile
echo -n "Checking Dockerfile... "
if [ -f Dockerfile ]; then
  echo -e "${GREEN}✓${NC}"
else
  echo -e "${RED}✗${NC}"
  echo "  → Dockerfile is required"
  ((ERRORS++))
fi

# Check if kamal gem is installed
echo -n "Checking kamal gem... "
if bundle exec kamal version >/dev/null 2>&1; then
  echo -e "${GREEN}✓${NC}"
else
  echo -e "${RED}✗${NC}"
  echo "  → Run: bundle install"
  ((ERRORS++))
fi

# Check SSH connection (if SERVER_IP is set)
if [ -n "$SERVER_IP" ] && [ -n "$SSH_USER" ]; then
  echo -n "Checking SSH connection to $SSH_USER@$SERVER_IP... "
  if ssh -o ConnectTimeout=5 -o BatchMode=yes $SSH_USER@$SERVER_IP exit 2>/dev/null; then
    echo -e "${GREEN}✓${NC}"
  else
    echo -e "${YELLOW}⚠${NC}"
    echo "  → Cannot connect via SSH. Check your SSH keys."
    ((WARNINGS++))
  fi
fi

# Check Docker on remote server
if [ -n "$SERVER_IP" ] && [ -n "$SSH_USER" ]; then
  echo -n "Checking Docker on remote server... "
  if ssh -o ConnectTimeout=5 -o BatchMode=yes $SSH_USER@$SERVER_IP "docker --version" >/dev/null 2>&1; then
    echo -e "${GREEN}✓${NC}"
  else
    echo -e "${YELLOW}⚠${NC}"
    echo "  → Docker not found or not accessible on remote server"
    ((WARNINGS++))
  fi
fi

# Check Traefik network on remote server
if [ -n "$SERVER_IP" ] && [ -n "$SSH_USER" ]; then
  echo -n "Checking Traefik network on remote server... "
  if ssh -o ConnectTimeout=5 -o BatchMode=yes $SSH_USER@$SERVER_IP "docker network inspect traefik" >/dev/null 2>&1; then
    echo -e "${GREEN}✓${NC}"
  else
    echo -e "${YELLOW}⚠${NC}"
    echo "  → Traefik network not found. It will be created on first deploy."
    ((WARNINGS++))
  fi
fi

# Check if config/deploy.yml has placeholders
echo -n "Checking config/deploy.yml for placeholders... "
if grep -q "YOUR_SERVER_IP\|YOUR_SSH_USER" config/deploy.yml; then
  echo -e "${RED}✗${NC}"
  echo "  → Run: make setup (or update config/deploy.yml manually)"
  ((ERRORS++))
else
  echo -e "${GREEN}✓${NC}"
fi

# Check registry authentication
echo -n "Checking registry authentication... "
if [ -n "$GHCR_TOKEN" ]; then
  if echo "$GHCR_TOKEN" | docker login ghcr.io -u kszinhu --password-stdin >/dev/null 2>&1; then
    echo -e "${GREEN}✓${NC}"
  else
    echo -e "${YELLOW}⚠${NC}"
    echo "  → Cannot authenticate with GitHub Container Registry"
    ((WARNINGS++))
  fi
else
  echo -e "${YELLOW}⚠${NC}"
fi

echo ""
echo "========================"

if [ $ERRORS -eq 0 ] && [ $WARNINGS -eq 0 ]; then
  echo -e "${GREEN}✅ All checks passed! Ready to deploy.${NC}"
  exit 0
elif [ $ERRORS -eq 0 ]; then
  echo -e "${YELLOW}⚠️  $WARNINGS warning(s) found. You can proceed but review warnings.${NC}"
  exit 0
else
  echo -e "${RED}❌ $ERRORS error(s) and $WARNINGS warning(s) found. Fix errors before deploying.${NC}"
  exit 1
fi
