# GitHub Container Registry Token
# Create at: https://github.com/settings/tokens
# Scopes needed: write:packages, read:packages, delete:packages
GHCR_TOKEN=ghp_your_token_here
KAMAL_REGISTRY_PASSWORD=ghp_your_token_here

# Server Configuration
SERVER_IP=your_server_ip_here
SSH_USER=your_ssh_user_here

# Domain Configuration
APP_DOMAIN=kszinhu.dev

# Traefik Network (usually 'traefik' if using default setup)
TRAEFIK_NETWORK=traefik
